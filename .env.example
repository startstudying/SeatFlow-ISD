# Data providers. Do not commit real credentials.
# The Tushare HTTP endpoint is official but its token is read only at runtime.
SEATFLOW_DATA_PROVIDER=sample
TUSHARE_TOKEN=
TUSHARE_API_URL=http://api.tushare.pro
# The official REST documentation uses HTTP. Explicit opt-in is required.
TUSHARE_ALLOW_INSECURE_HTTP=0

# Java backend infrastructure.
SPRING_PROFILES_ACTIVE=dev
SEATFLOW_JAVA_PORT=8080
SEATFLOW_FASTAPI_BASE_URL=http://localhost:8000
SEATFLOW_FASTAPI_CONNECT_TIMEOUT=2s
SEATFLOW_FASTAPI_READ_TIMEOUT=5s
SEATFLOW_DB_URL=jdbc:mysql://localhost:3306/seatflow?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SEATFLOW_DB_USERNAME=seatflow
SEATFLOW_DB_PASSWORD=seatflow
SEATFLOW_FLYWAY_ENABLED=false
SEATFLOW_REDIS_HOST=localhost
SEATFLOW_REDIS_PORT=6379
SEATFLOW_REDIS_PASSWORD=
SEATFLOW_NEO4J_ENABLED=false
SEATFLOW_NEO4J_BASE_URL=http://localhost:7474
SEATFLOW_NEO4J_USERNAME=neo4j
SEATFLOW_NEO4J_PASSWORD=
SEATFLOW_NEO4J_DATABASE=neo4j
SEATFLOW_SECURITY_ENABLED=false
SEATFLOW_API_KEY_HEADER=X-SeatFlow-Api-Key
SEATFLOW_API_KEY=
SEATFLOW_DEFAULT_ACTOR=local-internal
SEATFLOW_DEFAULT_ROLES=ADMIN
SEATFLOW_ENCRYPTION_ENABLED=false
# Generate with: openssl rand -base64 32
SEATFLOW_ENCRYPTION_KEY=
SEATFLOW_ENCRYPTION_KEY_ID=local

# Next.js business API gateway. Keep mock services enabled until the Java
# backend and database migrations are running locally.
SEATFLOW_JAVA_INTERNAL_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SEATFLOW_BACKEND_BASE_URL=/backend
NEXT_PUBLIC_SEATFLOW_DATA_CENTER_SOURCE=mock
NEXT_PUBLIC_SEATFLOW_SETTINGS_SOURCE=mock
