# Browser requests use the Next.js rewrite instead of reaching FastAPI or databases.
SEATFLOW_JAVA_INTERNAL_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SEATFLOW_BACKEND_BASE_URL=/backend
# Set both values to java-api after the Spring Boot service is available.
NEXT_PUBLIC_SEATFLOW_DATA_CENTER_SOURCE=mock
NEXT_PUBLIC_SEATFLOW_SETTINGS_SOURCE=mock
