# SeatFlow V3 local development environment configuration.
#
# This file contains DEVELOPMENT-ONLY placeholder values. No real credentials
# are present here. Copy to `.env` and override as needed for your local setup.
#
#     cp .env.example .env
#
# WARNING: Never commit real secrets to version control.

# ---- PostgreSQL ----
POSTGRES_USER=seatflow
POSTGRES_PASSWORD=seatflow_dev_password
POSTGRES_DB=control_center
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=seatflow_minio_user
MINIO_ROOT_PASSWORD=seatflow_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- MLflow tracking server ----
MLFLOW_PORT=5000

# ---- Prometheus ----
PROMETHEUS_PORT=9090

# ---- Grafana ----
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=seatflow_grafana_dev_password
