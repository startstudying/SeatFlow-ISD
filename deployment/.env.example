# Compatibility entrypoint for the canonical V3 Compose stack.
#
# Copy this file to `deployment/.env` only when invoking:
#
#   docker compose -f deployment/docker-compose.yml up
#
# Values intentionally mirror `infra/compose/.env.example`; the Compose model
# itself is included from there so service definitions cannot drift.

RESEARCH_ENGINE_PORT=8000
CONTROL_CENTER_PORT=8080
RESEARCH_CONSOLE_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
SEATFLOW_RUNTIME_MODE=fail-closed
SEATFLOW_ARTIFACT_ROOT=s3://models
SEATFLOW_SECURITY_JWT_SECRET=change-me-seatflow-dev-jwt-secret-32-bytes

POSTGRES_USER=seatflow
POSTGRES_PASSWORD=seatflow_dev_password
POSTGRES_DB=control_center
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=seatflow_minio_user
MINIO_ROOT_PASSWORD=seatflow_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MLFLOW_PORT=5000
PROMETHEUS_PORT=9090

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=seatflow_grafana_dev_password
