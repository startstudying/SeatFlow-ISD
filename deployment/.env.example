# Copy to deployment/.env and edit locally. Do not commit real secrets.

COMPOSE_PROJECT_NAME=seatflow
TZ=Asia/Shanghai

# Published host ports.
FASTAPI_PORT=8000
JAVA_PORT=8080
FRONTEND_PORT=3000
MYSQL_PORT=3306
MLFLOW_PORT=5000
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Local degraded/smoke defaults. Set provider and mount real data only after evidence gates pass.
SEATFLOW_DATA_PROVIDER=sample
SEATFLOW_DEFAULT_MODEL_ID=missing-checkpoint
SEATFLOW_DEFAULT_RUN_ID=
SEATFLOW_DEFAULT_TRADE_DATE=2026-01-15
SEATFLOW_DEFAULT_STOCK_ID=600000.SH

# MySQL stores business metadata only; training facts stay in versioned data/checkpoint artifacts.
MYSQL_DATABASE=seatflow
MYSQL_USER=seatflow
MYSQL_PASSWORD=change-me-seatflow
MYSQL_ROOT_PASSWORD=change-me-root

# MLflow server persists to the mlflow_data volume. Large artifacts should be mounted/exported externally.
MLFLOW_TRACKING_URI=http://mlflow:5000

# Redis is enabled for task progress/cache state. Neo4j remains a rebuildable
# optional graph projection that can be enabled with --profile graph.
REDIS_PASSWORD=
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
SEATFLOW_NEO4J_ENABLED=false
SEATFLOW_NEO4J_DATABASE=neo4j

# Build-time Next.js switches. The container uses the Spring Boot business API.
NEXT_PUBLIC_SEATFLOW_DATA_CENTER_SOURCE=java-api
NEXT_PUBLIC_SEATFLOW_SETTINGS_SOURCE=java-api
